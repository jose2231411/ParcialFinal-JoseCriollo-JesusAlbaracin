# Copie este archivo como .env y ajuste los valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).

# Puerto y dirección donde escucha este microservicio (examen: 3011 en 127.0.0.1)
PORT=3011
HOST=127.0.0.1

# Base de datos MySQL de este microservicio.
# En su PC: DB_HOST=localhost. En servidor2: la IP de servidor1 (172.24.0.134).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pedidos_db
DB_USER=pedidos_user
DB_PASSWORD=una-clave-segura

# DEBE SER LA MISMA que la de ms-usuarios: con ella se verifica el token.
JWT_SECRET=una-clave-segura
