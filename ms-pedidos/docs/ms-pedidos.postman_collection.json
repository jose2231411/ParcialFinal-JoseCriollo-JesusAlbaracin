{
  "info": {
    "name": "ms-pedidos · Evaluación M3",
    "description": "Ejecutar en orden con el Runner. El login guarda el token en la variable token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "usuariosUrl",
      "value": "http://localhost:3001"
    },
    {
      "key": "pedidosUrl",
      "value": "http://localhost:3011"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "numeroNuevo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 · Login",
      "item": [
        {
          "name": "Login administrador → 200 + token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuariosUrl}}/usuarios/login",
              "host": [
                "{{usuariosUrl}}"
              ],
              "path": [
                "usuarios",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@empresa.com\",\n  \"password\": \"Admin2026*\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const datos = pm.response.json();",
                  "pm.test('Trae token', () => pm.expect(datos.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', datos.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Consultas (200, 400, 404)",
      "item": [
        {
          "name": "Health → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/health",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar pedidos → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es un arreglo con al menos 3', () => pm.expect(pm.response.json()).to.be.an('array').with.length.at.least(3));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro ?estado=pendiente → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos?estado=pendiente",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "pendiente"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Todos pendientes', () => pm.response.json().forEach((p) => pm.expect(p.estado).to.eql('pendiente')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro ?ids=1,3 → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos?ids=1,3",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ],
              "query": [
                {
                  "key": "ids",
                  "value": "1,3"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Solo ids 1 y 3', () => pm.response.json().forEach((p) => pm.expect([1, 3]).to.include(p.id)));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtro estado inválido → 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos?estado=perdido",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "perdido"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener pedido 1 → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos/1",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos",
                "1"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Es el id 1', () => pm.expect(pm.response.json().id).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener id inválido → 400",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos/abc",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos",
                "abc"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Obtener pedido inexistente → 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos/99999",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos",
                "99999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 · Crear (201, 400, 409)",
      "item": [
        {
          "name": "Crear pedido → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"{{numeroNuevo}}\",\n  \"cliente\": \"Cliente Postman\",\n  \"cantidad\": 7,\n  \"fecha\": \"2026-11-22\",\n  \"estado\": \"pendiente\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('numeroNuevo', 'PED-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('Trae Location', () => pm.response.to.have.header('Location'));",
                  "pm.collectionVariables.set('pedidoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear con numero repetido → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"PED-001\",\n  \"cliente\": \"Cliente Postman\",\n  \"cantidad\": 7,\n  \"fecha\": \"2026-11-22\",\n  \"estado\": \"pendiente\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear con datos inválidos → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidosUrl}}/pedidos",
              "host": [
                "{{pedidosUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"PED-X\",\n  \"cliente\": \"\",\n  \"cantidad\": 0,\n  \"fecha\": \"2026-02-30\",\n  \"estado\": \"perdido\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 400', () => pm.response.to.have.status(400));",
                  "pm.test('Lista los errores', () => pm.expect(pm.response.json().detalles).to.have.length(4));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
