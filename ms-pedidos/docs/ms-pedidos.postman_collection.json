            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"{{numeroNuevo}}\",\n  \"cliente\": \"Cliente Postman\",\n  \"cantidad\": 9,\n  \"fecha\": \"2026-11-22\",\n  \"estado\": \"enviado\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Quedó enviado', () => pm.expect(pm.response.json().estado).to.eql('enviado'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar con numero de otro pedido → 409",
          "request": {
            "method": "PUT",
            "header": [
